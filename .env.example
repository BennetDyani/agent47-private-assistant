# Copy to .env and fill in. Never commit .env.

# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Seconds to wait between Gemini calls (keeps us under free-tier rate limits)
GEMINI_DELAY=4

# Azure Speech, free F0 tier: create a "Speech" resource in the Azure portal
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southafricanorth
